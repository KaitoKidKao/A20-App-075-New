# --- AI MODELS ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY_BACKUP_1=
OPENAI_API_KEY_BACKUP_2=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=low
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_API_TOKEN_BACKUP_1=
REPLICATE_API_TOKEN_BACKUP_2=
# REPLICATE_IMAGE_MODEL is kept for avatar/video features if needed
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
DEFAULT_MODEL=gpt-4o-mini

# --- RUNTIME ---
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false
SECRET_KEY=replace-with-a-strong-secret

# --- DATABASE / QUEUE ---
DATABASE_URL=sqlite:///data/lecture_platform.db
REDIS_URL=redis://localhost:6379/0

# --- API LIMITS ---
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=14400
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/x-matroska
LOGIN_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=20/hour
AVATAR_RATE_LIMIT=10/hour
ALLOW_PUBLIC_ROLE_REGISTRATION=false

# --- CORS / AUTH COOKIE ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ALLOW_ROLE_REGISTRATION=false

# --- DOCKER COMPOSE DEFAULTS ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app075
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- AI HOOK LOGGING (default) ---
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-if-you-use-custom-log-server-key
AI_LOG_DIR=.ai-log
