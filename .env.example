# --- AI MODELS ---
OPENAI_API_KEY=your_openai_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
DEFAULT_MODEL=gpt-4o-mini

# --- RUNTIME ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-strong-secret

# --- DATABASE / QUEUE ---
DATABASE_URL=sqlite:///data/lecture_platform.db
REDIS_URL=redis://localhost:6379/0

# --- API LIMITS ---
MAX_UPLOAD_SIZE_MB=500

# --- CORS / AUTH COOKIE ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI HOOK LOGGING (default) ---
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-if-you-use-custom-log-server-key
AI_LOG_DIR=.ai-log

# --- SYSTEM ADMIN (Tự động khởi tạo khi startup nếu chưa có) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_password
