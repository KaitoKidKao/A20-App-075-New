# --- AI MODELS ---
# OpenAI API Key (Dùng cho Agent gpt-4o-mini)
OPENAI_API_KEY=sk-proj-your-openai-key-here
DEFAULT_MODEL=gpt-4o-mini

# Chandra OCR API Key (Dùng cho luồng trích xuất chính)
CHANDRA_API_KEY=your-chandra-key-here

# (Optional) Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- CONFIGURATION ---
LOG_LEVEL=INFO

# --- AI HOOK LOGGING (Mặc định - Không cần sửa) ---
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
