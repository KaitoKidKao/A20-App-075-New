__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/

# OS
.DS_Store

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
temp/
data/
.grapuco/
.claude/

# Logs and binaries
backend.log
ffmpeg.exe

# Database files
*.sql
*.dump

