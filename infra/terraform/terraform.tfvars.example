# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored — NEVER commit real secrets.

aws_region   = "ap-southeast-1"   # Singapore — closest to Vietnam
environment  = "prod"
project_name = "a20"

# Find your current public IP: curl ifconfig.me
your_ip_cidr = "YOUR_PUBLIC_IP/32"

# Create key pair in AWS Console → EC2 → Key Pairs, download the .pem file
ec2_key_pair_name = "a20-keypair"

# Database credentials (use a strong password — no @ or / chars)
db_username = "a20user"
db_password = "CHANGE_ME_strong_password_here"
db_name     = "a20db"

# GitHub settings
github_repo         = "YouttyLe-DSAI/A20-App-075-New"
github_branch       = "main"
# Generate at: https://github.com/settings/tokens (repo scope)
github_access_token = "ghp_REPLACE_WITH_YOUR_TOKEN"
